<Window x:Class="BusinessOS.Restaurant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:BusinessOS.Restaurant.Desktop"
        Title="BusinessOS — Restaurant"
        Width="1366" Height="830"
        MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" SizeChanged="OnWindowSizeChanged"
        Background="{DynamicResource AppBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <nav:NavigationRouteMatchConverter x:Key="NavigationRouteMatchConverter" />
        <nav:NavigationGroupMatchConverter x:Key="NavigationGroupMatchConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                </Trigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource NavigationRouteMatchConverter}">
                            <Binding Path="CurrentRoute" />
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top-navigation dropdown trigger: same pill as a route button, but
             highlighted orange while any route in its Tag group is active. -->
        <Style x:Key="NavMenuButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource NavigationGroupMatchConverter}">
                            <Binding Path="CurrentRoute" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotificationSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NotificationItemTemplate">
            <Border Style="{StaticResource NotificationSurfaceStyle}" Margin="0,0,0,8">
                <!-- Subtle entrance on both toasts and notification history entries. -->
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.22" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="TopBarGhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TopBarActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Cache only the already-blurred decorative artwork at reduced render scale.
             On 4K monitors the full-window shader otherwise allocates an enormous
             intermediate surface; foreground text and controls remain vector-sharp. -->
        <Image x:Name="RestaurantBackdrop" Source="Assets/RestaurantGlassBackground.jpg"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Effect="{DynamicResource BackgroundBlurEffect}">
            <Image.CacheMode>
                <BitmapCache RenderAtScale="0.5" />
            </Image.CacheMode>
        </Image>
        <Border Background="{DynamicResource ShellBackdropOverlayBrush}" />

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="TopNavigationBar" Grid.Row="0"
                    Background="{DynamicResource TopBarBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,7">
                <DockPanel LastChildFill="True">
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,14,0">
                        <Border Width="38" Height="38" CornerRadius="12"
                                Background="{DynamicResource BrandPrimaryBrush}">
                            <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="BrandText" Margin="10,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BusinessOS" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="RESTAURANT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}"
                                       Margin="0,-2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right side: compact account menu, then All Modules at the far right. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shell status and quick actions live in the top menu bar. -->
                        <Border x:Name="NetworkModeBadge"
                                Background="{DynamicResource SuccessSoftBrush}"
                                CornerRadius="12"
                                Padding="10,6"
                                Margin="0,0,4,0">
                            <TextBlock Text="{Binding NetworkMode, StringFormat=&#x25CF;  {0}}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource TopBarGhostButton}"
                                Content="{Binding ThemeButtonText}"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="Switch between Classic and Glass appearance" />
                        <Button x:Name="RefreshButton" Margin="6,0,0,0"
                                Style="{StaticResource TopBarGhostButton}"
                                Content="&#x21BB;  Refresh"
                                Command="{Binding RefreshCommand}" />
                        <Button x:Name="NotificationBellButton" Margin="6,0,0,0"
                                Style="{StaticResource TopBarGhostButton}"
                                Content="{Binding NotificationBellLabel}"
                                ToolTip="Show restaurant notifications"
                                AutomationProperties.Name="Notifications"
                                Command="{Binding ToggleNotificationsCommand}" />
                            <Popup PlacementTarget="{Binding ElementName=NotificationBellButton}"
                                   Placement="Bottom" HorizontalOffset="-250" VerticalOffset="10"
                                   AllowsTransparency="True" StaysOpen="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding NotificationsOpen, Mode=TwoWay}"
                                   DataContext="{Binding DataContext, ElementName=NotificationBellButton}">
                                <Border Width="360" MaxHeight="480" Padding="14"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="5"
                                                          Color="#0E223A" Opacity="0.25" />
                                    </Border.Effect>
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Button Content="Mark read" DockPanel.Dock="Right"
                                                    Style="{StaticResource TopBarGhostButton}"
                                                    Command="{Binding MarkNotificationsReadCommand}" />
                                            <TextBlock Text="Notifications" FontSize="17"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="380">
                                            <StackPanel>
                                                <TextBlock Text="Recent alerts for this operator session"
                                                           Margin="0,0,0,8" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <ItemsControl ItemsSource="{Binding NotificationHistory}"
                                                              ItemTemplate="{StaticResource NotificationItemTemplate}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        <Button x:Name="UserMenuButton" Style="{StaticResource TopBarGhostButton}"
                                Click="OnUserMenuClick"
                                ToolTip="Account, restaurant and sign out"
                                AutomationProperties.Name="Operator menu">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE77B;"
                                           VerticalAlignment="Center" />
                                <Border x:Name="OperatorBadge" Margin="7,0,4,0" Padding="8,4"
                                        CornerRadius="9"
                                        Background="{DynamicResource TopBarActionBrush}">
                                    <TextBlock Text="{Binding OperatorLabel}" FontSize="12"
                                               FontWeight="SemiBold" MaxWidth="150"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Button>
                        <Popup x:Name="UserMenuPopup"
                               PlacementTarget="{Binding ElementName=UserMenuButton}"
                               Placement="Bottom" HorizontalOffset="-240" VerticalOffset="6"
                               AllowsTransparency="True" StaysOpen="False"
                               DataContext="{Binding DataContext, ElementName=TopNavigationBar}">
                            <Border Width="280" Padding="16"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="5"
                                                      Color="#0E223A" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding OperatorLabel}" FontSize="14"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TenantLabel}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,1,0,0" Margin="0,12,0,12" />
                                    <Button x:Name="SwitchOperatorButton" Content="Log out"
                                            Style="{StaticResource TopBarGhostButton}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnSwitchOperatorClick"
                                            AutomationProperties.Name="Log out" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button x:Name="AllModulesButton" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryActionButton}"
                                Padding="14,8" MinHeight="38"
                                Command="{Binding NavigateCommand}" CommandParameter="modules"
                                Visibility="{Binding CanViewModules, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Show all modules" AutomationProperties.Name="All Modules">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x229E;" FontSize="16" Margin="0,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="All Modules" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Primary links and grouped dropdowns. -->
                    <Grid VerticalAlignment="Center">
                        <ScrollViewer x:Name="TopNavScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TopNavLinks" Orientation="Horizontal">
                                <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Dashboard"
                                        Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                                        Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE80F;" Width="28" />
                                        <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" AutomationProperties.Name="POS &amp; Orders"
                                        Command="{Binding NavigateCommand}" CommandParameter="pos"
                                        Visibility="{Binding CanViewPos, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE7BF;" Width="28" />
                                        <TextBlock Text="POS &amp; Orders" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Tables &amp; Floor"
                                        Command="{Binding NavigateCommand}" CommandParameter="tables"
                                        Visibility="{Binding CanViewTables, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8A0;" Width="28" />
                                        <TextBlock Text="Tables &amp; Floor" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Kitchen / KOT"
                                        Command="{Binding NavigateCommand}" CommandParameter="kitchen"
                                        Visibility="{Binding CanViewKitchen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE713;" Width="28" />
                                        <TextBlock Text="Kitchen / KOT" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CatalogMenuButton" Style="{StaticResource NavMenuButton}"
                                        Tag="menu,recipes" Click="OnNavMenuClick"
                                        AutomationProperties.Name="Catalog menu"
                                        Visibility="{Binding CanViewCatalogMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Catalog" VerticalAlignment="Center" />
                                        <TextBlock Text="▾" FontSize="10" Margin="6,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="CatalogMenuPopup"
                                       PlacementTarget="{Binding ElementName=CatalogMenuButton}"
                                       Placement="Bottom" VerticalOffset="4"
                                       AllowsTransparency="True" StaysOpen="False"
                                       DataContext="{Binding DataContext, ElementName=TopNavigationBar}">
                                    <Border Width="250" Padding="8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                              Color="#0E223A" Opacity="0.22" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Menu &amp; Products"
                                                    Command="{Binding NavigateCommand}" CommandParameter="menu"
                                                    Visibility="{Binding CanViewMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8A5;" Width="28" />
                                                    <TextBlock Text="Menu &amp; Products" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Recipes &amp; Food Cost"
                                                    Command="{Binding NavigateCommand}" CommandParameter="recipes"
                                                    Visibility="{Binding CanViewRecipes, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8D2;" Width="28" />
                                                    <TextBlock Text="Recipes &amp; Food Cost" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button x:Name="StockMenuButton" Style="{StaticResource NavMenuButton}"
                                        Tag="inventory,purchases,expenses,closing" Click="OnNavMenuClick"
                                        AutomationProperties.Name="Stock menu"
                                        Visibility="{Binding CanViewStockMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Stock" VerticalAlignment="Center" />
                                        <TextBlock Text="▾" FontSize="10" Margin="6,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="StockMenuPopup"
                                       PlacementTarget="{Binding ElementName=StockMenuButton}"
                                       Placement="Bottom" VerticalOffset="4"
                                       AllowsTransparency="True" StaysOpen="False"
                                       DataContext="{Binding DataContext, ElementName=TopNavigationBar}">
                                    <Border Width="250" Padding="8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                              Color="#0E223A" Opacity="0.22" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Inventory"
                                                    Command="{Binding NavigateCommand}" CommandParameter="inventory"
                                                    Visibility="{Binding CanViewInventory, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE719;" Width="28" />
                                                    <TextBlock Text="Inventory" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Purchases"
                                                    Command="{Binding NavigateCommand}" CommandParameter="purchases"
                                                    Visibility="{Binding CanViewPurchases, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8D4;" Width="28" />
                                                    <TextBlock Text="Purchases" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Expenses"
                                                    Command="{Binding NavigateCommand}" CommandParameter="expenses"
                                                    Visibility="{Binding CanViewExpenses, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8D4;" Width="28" />
                                                    <TextBlock Text="Expenses" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Daily Closing"
                                                    Command="{Binding NavigateCommand}" CommandParameter="closing"
                                                    Visibility="{Binding CanViewClosing, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE10A;" Width="28" />
                                                    <TextBlock Text="Daily Closing" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button x:Name="ManageMenuButton" Style="{StaticResource NavMenuButton}"
                                        Tag="reports,users,settings" Click="OnNavMenuClick"
                                        AutomationProperties.Name="Manage menu"
                                        Visibility="{Binding CanViewManageMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Manage" VerticalAlignment="Center" />
                                        <TextBlock Text="▾" FontSize="10" Margin="6,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="ManageMenuPopup"
                                       PlacementTarget="{Binding ElementName=ManageMenuButton}"
                                       Placement="Bottom" VerticalOffset="4"
                                       AllowsTransparency="True" StaysOpen="False"
                                       DataContext="{Binding DataContext, ElementName=TopNavigationBar}">
                                    <Border Width="250" Padding="8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                              Color="#0E223A" Opacity="0.22" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Reports &amp; Accounting"
                                                    Command="{Binding NavigateCommand}" CommandParameter="reports"
                                                    Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE9D9;" Width="28" />
                                                    <TextBlock Text="Reports &amp; Accounting" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Users &amp; Roles"
                                                    Command="{Binding NavigateCommand}" CommandParameter="users"
                                                    Visibility="{Binding CanViewUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE77B;" Width="28" />
                                                    <TextBlock Text="Users &amp; Roles" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Settings"
                                                    Command="{Binding NavigateCommand}" CommandParameter="settings"
                                                    Visibility="{Binding CanViewSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE713;" Width="28" />
                                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tablet/narrow: the primary route links collapse into this menu.
                             All Modules and the account menu stay reachable to the right. -->
                        <Button x:Name="TopNavCompactButton" Style="{StaticResource NavMenuButton}"
                                Content="☰  Modules" Visibility="Collapsed"
                                HorizontalAlignment="Left" Click="OnNavMenuClick"
                                AutomationProperties.Name="Modules menu" />
                        <Popup x:Name="TopNavCompactMenu"
                               PlacementTarget="{Binding ElementName=TopNavCompactButton}"
                               Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" StaysOpen="False"
                               DataContext="{Binding DataContext, ElementName=TopNavigationBar}">
                            <Border Width="250" Padding="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                      Color="#0E223A" Opacity="0.22" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Dashboard (compact)"
                                            Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE80F;" Width="28" />
                                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavButton}" AutomationProperties.Name="POS &amp; Orders (compact)"
                                            Command="{Binding NavigateCommand}" CommandParameter="pos"
                                            Visibility="{Binding CanViewPos, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE7BF;" Width="28" />
                                            <TextBlock Text="POS &amp; Orders" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Tables &amp; Floor (compact)"
                                            Command="{Binding NavigateCommand}" CommandParameter="tables"
                                            Visibility="{Binding CanViewTables, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8A0;" Width="28" />
                                            <TextBlock Text="Tables &amp; Floor" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavButton}" AutomationProperties.Name="Kitchen / KOT (compact)"
                                            Command="{Binding NavigateCommand}" CommandParameter="kitchen"
                                            Visibility="{Binding CanViewKitchen, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE713;" Width="28" />
                                            <TextBlock Text="Kitchen / KOT" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>


            <Grid x:Name="WorkspaceShell" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!-- Only show a recovery action when the most recent workspace load fails.
                     A failed load never replaces the current operational page. -->
                <Border Grid.Row="0"
                        Visibility="{Binding HasWorkspaceError, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource BrandPrimarySoftBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource TopBarGhostButton}"
                                Content="Retry workspace"
                                Command="{Binding RetryWorkspaceCommand}"
                                Margin="12,0,0,0" />
                        <TextBlock Text="{Binding WorkspaceErrorMessage}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border x:Name="WorkspaceSurface" Grid.Row="1"
                        Background="{DynamicResource PageBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="14">
                    <!-- Constrain very wide 4K pages without scaling the visual tree.
                         Smaller resolutions retain their full available width. -->
                    <ContentControl x:Name="WorkspaceContent"
                                    Content="{Binding CurrentPage}"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="1900"
                                    SnapsToDevicePixels="True" />
                </Border>

                <!-- Non-blocking progress: do not hide or disable the active
                     page while SQLite builds the next workspace. -->
                <Border Grid.Row="1" Panel.ZIndex="25"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,20,0" Padding="12,7"
                        CornerRadius="12"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsWorkspaceLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◌" FontSize="16" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding WorkspaceLoadingMessage}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- The POS owns the entire screen. Always provide a discoverable
                     way back to the standard navigation and desktop chrome. -->
                <Button x:Name="ExitPosButton" Grid.Row="1"
                        Panel.ZIndex="35"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,24,0" Padding="16,9"
                        Background="#0F172A"
                        Foreground="White" FontWeight="Bold"
                        Content="⛶  Restore window (F11)" Visibility="Collapsed"
                        Click="OnExitPosClick" />
            </Grid>
        </Grid>

        <!-- Toast overlay belongs to the shell, not to the current page. It
             never blocks kitchen, table or cashier actions after expiry. -->
        <ItemsControl Grid.Row="0" Grid.Column="0" Panel.ZIndex="20"
                      Width="355" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="12,12,18,18" ItemsSource="{Binding ToastNotifications}"
                      ItemTemplate="{StaticResource NotificationItemTemplate}" />
    </Grid>
</Window>
