<Window x:Class="BusinessOS.Restaurant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BusinessOS Restaurant"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FB">
        <Border Margin="24"
                Padding="28"
                CornerRadius="18"
                Background="White">
            <StackPanel>
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Text="BusinessOS Restaurant" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="#64748B"
                           Text="Native Windows KOT, cashier and restaurant operations client" />
                <Border Margin="0,28,0,0"
                        Padding="18"
                        CornerRadius="12"
                        Background="#F8FAFC">
                    <TextBlock FontSize="15"
                               Text="Desktop foundation is ready. KOT workflow modules will be added in the next batches." />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
