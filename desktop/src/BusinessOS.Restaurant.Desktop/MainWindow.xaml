<Window x:Class="BusinessOS.Restaurant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BusinessOS Restaurant"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="24,24,24,12"
                Padding="24"
                CornerRadius="18"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="SemiBold"
                               Text="BusinessOS Restaurant" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="#64748B"
                               Text="Local restaurant host · terminals · cloud reconciliation" />
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="120"
                        Height="40"
                        Padding="18,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Network mode" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding NetworkMode}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Offline lease" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding LeaseStatus}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Cloud queue" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding PendingCloudMutations}" />
                                <TextBlock Margin="6,5,0,0"
                                           Foreground="#64748B"
                                           Text="pending" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Cloud conflicts" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding OpenCloudConflicts}" />
                                <TextBlock Margin="6,5,0,0"
                                           Foreground="#64748B"
                                           Text="open" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,0,0,14"
                        Padding="18"
                        CornerRadius="14"
                        Background="White">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Operational status" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#64748B"
                                   Text="{Binding CloudStatus}" />
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        CornerRadius="14"
                        Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="LAN terminals" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#64748B"
                                           Text="{Binding TerminalSummary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button MinWidth="130"
                                        Height="36"
                                        Padding="14,0"
                                        Command="{Binding ToggleSelectedTerminalCommand}"
                                        Content="{Binding ToggleTerminalLabel}" />
                                <Button Margin="8,0,0,0"
                                        MinWidth="100"
                                        Height="36"
                                        Padding="14,0"
                                        Command="{Binding UnpairSelectedTerminalCommand}"
                                        Content="Unpair" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,8"
                                   Foreground="#94A3B8"
                                   Text="Select a terminal to manage it. Enable/disable and unpair actions require an owner or manager session." />

                        <DataGrid Grid.Row="2"
                                  MinHeight="330"
                                  Margin="0,4,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Terminals}"
                                  SelectedItem="{Binding SelectedTerminal, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.4*" Header="Terminal" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Width="*" Header="Type" Binding="{Binding ClientType}" />
                                <DataGridTextColumn Width="1.2*" Header="User" Binding="{Binding UserName}" />
                                <DataGridTextColumn Width="*" Header="Role" Binding="{Binding UserRole}" />
                                <DataGridTextColumn Width="*" Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Width="*" Header="Version" Binding="{Binding AppVersion}" />
                                <DataGridTextColumn Width="1.2*" Header="IP address" Binding="{Binding LastIpAddress}" />
                                <DataGridTextColumn Width="1.5*" Header="Last seen (UTC)" Binding="{Binding LastSeenAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
