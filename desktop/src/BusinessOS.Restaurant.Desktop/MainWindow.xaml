<Window x:Class="BusinessOS.Restaurant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BusinessOS Restaurant"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="24,24,24,12"
                Padding="24"
                CornerRadius="18"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="SemiBold"
                               Text="BusinessOS Restaurant" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="#64748B"
                               Text="Local restaurant host · terminals · cloud reconciliation" />
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="120"
                        Height="40"
                        Padding="18,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">
                <TabControl>
                <TabItem Header="LAN &amp; Sync"><StackPanel Margin="12"><Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Network mode" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding NetworkMode}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Offline lease" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding LeaseStatus}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Cloud queue" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding PendingCloudMutations}" />
                                <TextBlock Margin="6,5,0,0"
                                           Foreground="#64748B"
                                           Text="pending" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Padding="18" CornerRadius="14" Background="White">
                        <StackPanel>
                            <TextBlock Foreground="#64748B" Text="Cloud conflicts" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding OpenCloudConflicts}" />
                                <TextBlock Margin="6,5,0,0"
                                           Foreground="#64748B"
                                           Text="open" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,0,0,14"
                        Padding="18"
                        CornerRadius="14"
                        Background="White">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Operational status" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#64748B"
                                   Text="{Binding CloudStatus}" />
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        CornerRadius="14"
                        Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="LAN terminals" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#64748B"
                                           Text="{Binding TerminalSummary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button MinWidth="130"
                                        Height="36"
                                        Padding="14,0"
                                        Command="{Binding ToggleSelectedTerminalCommand}"
                                        Content="{Binding ToggleTerminalLabel}" />
                                <Button Margin="8,0,0,0"
                                        MinWidth="100"
                                        Height="36"
                                        Padding="14,0"
                                        Command="{Binding UnpairSelectedTerminalCommand}"
                                        Content="Unpair" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,8"
                                   Foreground="#94A3B8"
                                   Text="Select a terminal to manage it. Enable/disable and unpair actions require an owner or manager session." />

                        <DataGrid Grid.Row="2"
                                  MinHeight="330"
                                  Margin="0,4,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Terminals}"
                                  SelectedItem="{Binding SelectedTerminal, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.4*" Header="Terminal" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Width="*" Header="Type" Binding="{Binding ClientType}" />
                                <DataGridTextColumn Width="1.2*" Header="User" Binding="{Binding UserName}" />
                                <DataGridTextColumn Width="*" Header="Role" Binding="{Binding UserRole}" />
                                <DataGridTextColumn Width="*" Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Width="*" Header="Version" Binding="{Binding AppVersion}" />
                                <DataGridTextColumn Width="1.2*" Header="IP address" Binding="{Binding LastIpAddress}" />
                                <DataGridTextColumn Width="1.5*" Header="Last seen (UTC)" Binding="{Binding LastSeenAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border></StackPanel></TabItem>
                    <TabItem Header="Reports &amp; Accounting">
                        <StackPanel Margin="12" DataContext="{Binding Reports}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="34" Text="{Binding BranchId, UpdateSourceTrigger=PropertyChanged}" />
                                <DatePicker Grid.Column="2" SelectedDate="{Binding From}" />
                                <DatePicker Grid.Column="4" SelectedDate="{Binding To}" />
                                <Button Grid.Column="5" Width="120" Height="34" HorizontalAlignment="Right" Command="{Binding RefreshReportsCommand}" Content="Run report"/>
                            </Grid>
                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <Border Margin="0,0,8,0" Padding="16" CornerRadius="12" Background="White"><StackPanel><TextBlock Foreground="#64748B" Text="Net sales"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sales}"/></StackPanel></Border>
                                <Border Margin="0,0,8,0" Padding="16" CornerRadius="12" Background="White"><StackPanel><TextBlock Foreground="#64748B" Text="Gross profit"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding GrossProfit}"/></StackPanel></Border>
                                <Border Margin="0,0,8,0" Padding="16" CornerRadius="12" Background="White"><StackPanel><TextBlock Foreground="#64748B" Text="Inventory value"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding InventoryValue}"/></StackPanel></Border>
                                <Border Padding="16" CornerRadius="12" Background="White"><StackPanel><TextBlock Foreground="#64748B" Text="Cash variance"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding CashVariance}"/></StackPanel></Border>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <Border Margin="0,0,8,0" Padding="16" CornerRadius="12" Background="White"><StackPanel><TextBlock Foreground="#64748B" Text="Outstanding"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Outstanding}"/></StackPanel></Border>
                                <Border Padding="16" CornerRadius="12" Background="White"><StackPanel><TextBlock Foreground="#64748B" Text="Gross margin"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding GrossMargin}"/></StackPanel></Border>
                            </UniformGrid>
                            <TextBlock Margin="0,0,0,10" Foreground="#64748B" Text="{Binding Status}"/>
                            <TabControl>
                                <TabItem Header="Sales trend"><DataGrid MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding SalesTrend}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" Width="*"/><DataGridTextColumn Header="Bills" Binding="{Binding BillCount}" Width="*"/><DataGridTextColumn Header="Net sales" Binding="{Binding NetSales, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Payments" Binding="{Binding Payments, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="COGS" Binding="{Binding CostOfGoods, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Gross profit" Binding="{Binding GrossProfit, StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
                                <TabItem Header="Payments"><DataGrid MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Payments}"><DataGrid.Columns><DataGridTextColumn Header="Payment method" Width="*" Binding="{Binding Method}"/><DataGridTextColumn Header="Count" Width="*" Binding="{Binding Count}"/><DataGridTextColumn Header="Amount (AFN)" Width="*" Binding="{Binding Amount, StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem>
                                <TabItem Header="Top items"><DataGrid MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding TopItems}"><DataGrid.Columns><DataGridTextColumn Header="Item" Width="*" Binding="{Binding ItemName}"/><DataGridTextColumn Header="Qty" Width="*" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Sales (AFN)" Width="*" Binding="{Binding Sales, StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem>
                                <TabItem Header="Accounting"><DataGrid MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Accounting}"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/><DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="2*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
                                <TabItem Header="Daily closing"><DataGrid MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Closings}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="Net sales" Binding="{Binding NetSales, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Payments" Binding="{Binding Payments, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Variance" Binding="{Binding CashVariance, StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
                                <TabItem Header="Inventory"><DataGrid MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Inventory}"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/><DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="2*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Avg cost" Binding="{Binding AverageUnitCost, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" Width="*"/><DataGridCheckBoxColumn Header="Low stock" Binding="{Binding IsLowStock}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
                            </TabControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
