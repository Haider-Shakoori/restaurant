<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BusinessOS.Restaurant.Desktop</AssemblyName>
    <RootNamespace>BusinessOS.Restaurant.Desktop</RootNamespace>
    <Product>BusinessOS Restaurant</Product>
    <Company>BusinessOS.af</Company>
    <Description>BusinessOS Restaurant Desktop</Description>
    <Authors>BusinessOS.af</Authors>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\BusinessOS.Restaurant.ico')">Assets\BusinessOS.Restaurant.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\RestaurantGlassBackground.jpg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BusinessOS.Restaurant.Application/BusinessOS.Restaurant.Application.csproj" />
    <ProjectReference Include="../BusinessOS.Restaurant.Persistence/BusinessOS.Restaurant.Persistence.csproj" />
    <ProjectReference Include="../BusinessOS.Restaurant.Licensing/BusinessOS.Restaurant.Licensing.csproj" />
    <ProjectReference Include="../BusinessOS.Restaurant.Authentication/BusinessOS.Restaurant.Authentication.csproj" />
    <ProjectReference Include="../BusinessOS.Restaurant.LocalServer/BusinessOS.Restaurant.LocalServer.csproj" />
    <ProjectReference Include="../BusinessOS.Restaurant.Sync/BusinessOS.Restaurant.Sync.csproj" />
    <ProjectReference Include="../BusinessOS.Restaurant.Printing/BusinessOS.Restaurant.Printing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
