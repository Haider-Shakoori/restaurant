<Window x:Class="BusinessOS.Restaurant.Desktop.OperatorSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — BusinessOS Restaurant"
        Width="680" Height="670" MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Image x:Name="RestaurantBackdrop"
               Source="Assets/RestaurantGlassBackground.jpg"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Effect="{DynamicResource BackgroundBlurEffect}" />
        <Border Background="{DynamicResource ShellBackdropOverlayBrush}" />
        <Border Margin="42"
                Padding="34"
                CornerRadius="24"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.22" Color="#0C2036" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="BusinessOS Restaurant"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                    <TextBlock Text="Operator sign in"
                               FontSize="29" FontWeight="Bold"
                               Margin="0,26,0,4" />
                    <TextBlock Text="Sign in once while online. Your protected Windows session can be reused for permitted offline restaurant work."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24" />

                    <TextBlock Text="Restaurant tenant URL" FontWeight="SemiBold" />
                    <TextBox x:Name="TenantUrlBox" Margin="0,7,0,15" MinHeight="42"
                             ToolTip="For example https://your-restaurant.restaurant.businessos.af" />

                    <TextBlock Text="Email" FontWeight="SemiBold" />
                    <TextBox x:Name="EmailBox" Margin="0,7,0,15" MinHeight="42"
                             AutomationProperties.Name="Operator email" />

                    <TextBlock Text="Password" FontWeight="SemiBold" />
                    <PasswordBox x:Name="PasswordInput"
                                 Margin="0,7,0,18" MinHeight="42"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderStrongBrush}"
                                 BorderThickness="1" Padding="10,7"
                                 AutomationProperties.Name="Operator password" />

                    <Button x:Name="SignInButton" Content="Sign in to restaurant"
                            MinHeight="46" Click="OnSignInClick" IsDefault="True" />
                    <Button Content="Cancel" Margin="0,10,0,0" MinHeight="38"
                            Click="OnCancelClick" IsCancel="True"
                            Background="{DynamicResource TopBarActionBrush}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" />

                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>