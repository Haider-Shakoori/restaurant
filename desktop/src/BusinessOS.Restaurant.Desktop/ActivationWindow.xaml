<Window x:Class="BusinessOS.Restaurant.Desktop.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate BusinessOS Restaurant"
        Width="760" Height="640"
        MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Image Source="Assets/RestaurantGlassBackground.jpg"
               Stretch="UniformToFill"
               Effect="{DynamicResource BackgroundBlurEffect}" />
        <Border Background="{DynamicResource ShellBackdropOverlayBrush}" />

        <Grid Margin="52">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="34">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="8"
                                      Opacity="0.28"
                                      Color="#071827" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="54" Height="54" CornerRadius="16"
                                    Background="{DynamicResource BrandPrimaryBrush}">
                                <TextBlock Text="B" Foreground="White"
                                           FontSize="27" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,2,0,0">
                                <TextBlock Text="BusinessOS" FontSize="21" FontWeight="Bold" />
                                <TextBlock Text="Restaurant" FontSize="21" FontWeight="Bold"
                                           Foreground="{DynamicResource BrandPrimaryBrush}"
                                           Margin="0,-3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Activate this restaurant computer"
                                   FontSize="28" FontWeight="Bold"
                                   Margin="0,28,0,0" />
                        <TextBlock Text="Your license is securely verified with restaurant.businessos.af and then bound to this Windows installation."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="22"
                                   Margin="0,8,0,22" />

                        <Border Background="#26FFFFFF"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18"
                                Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="New restaurant?"
                                           FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="Start the 7-day trial on the BusinessOS Restaurant website. When your restaurant is provisioned, enter the generated license key here."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12" />
                                <Button Content="Start 7-Day Trial"
                                        Click="OnTrialClick"
                                        HorizontalAlignment="Left"
                                        MinWidth="170" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="License key" FontWeight="SemiBold" />
                        <TextBox x:Name="LicenseKeyBox"
                                 MinHeight="46"
                                 Margin="0,7,0,0"
                                 FontSize="15" />

                        <Button x:Name="ActivateButton"
                                Content="Activate this computer"
                                Click="OnActivateClick"
                                MinHeight="46"
                                Margin="0,14,0,0" />

                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,14,0,0"
                                   Text="Enter your license key, or start a 7-day trial above." />

                        <Separator Margin="0,22,0,16"
                                   Background="{DynamicResource BorderBrush}" />

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Activation requires internet once. The activation is stored securely on this computer using Windows protection and is reused automatically by future installer runs." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
