<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ShellBackdropOverlayBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F8FAFC" />
    <!-- Theme-aware white-glass workspace shared by Settings and Kitchen/KOT. -->
    <SolidColorBrush x:Key="WorkspaceFrostedBackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="WorkspaceFrostedBorderBrush" Color="#00FFFFFF" />
    <Thickness x:Key="WorkspaceFrostedPadding">0</Thickness>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <!-- Floor board keeps its own legible cards in Classic mode. -->
    <SolidColorBrush x:Key="FloorAreaBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FloorTileBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="FloorTileBorderBrush" Color="#CBD5E1" />
    <!-- Opaque nested data surfaces in Classic mode. -->
    <SolidColorBrush x:Key="GridRowBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="GridAlternatingRowBackgroundBrush" Color="#F2F6FB" />
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#EAF1F9" />
    <SolidColorBrush x:Key="GridSelectedRowBrush" Color="#DCEBFF" />
    <SolidColorBrush x:Key="TopBarActionBrush" Color="#F0F5FB" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#F97316" />
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="#FFF1E6" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#169B62" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFF7ED" />
    <!-- Sign-in photography stays crisp; Classic keeps it invisible. -->
    <SolidColorBrush x:Key="LoginScrimBrush" Color="#00FFFFFF" />
    <!-- Solid accessible actions. Both themes provide the exact same brush keys.
         Orange leads the brand; dark charcoal text keeps every state at or
         above the 4.5:1 contrast guard. -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#F97316" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ButtonOutlineBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="ButtonFocusBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="ButtonSecondaryPressedBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="ButtonSecondaryOutlineBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#475569" />
    <SolidColorBrush x:Key="ButtonDisabledOutlineBrush" Color="#CBD5E1" />
    <effects:BlurEffect x:Key="BackgroundBlurEffect" Radius="0" />
</ResourceDictionary>
