<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">
    <!-- Glass mode deliberately keeps the restaurant artwork visible through every shell layer. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1622" />
    <SolidColorBrush x:Key="ShellBackdropOverlayBrush" Color="#35071424" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#B6F8FAFC" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#A9F8FAFC" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#38FFFFFF" />

    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BFFFFFFF" Offset="0" />
        <GradientStop Color="#93F8FAFC" Offset="0.58" />
        <GradientStop Color="#7FEAF4FB" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBorderBrush" Color="#C8FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#C9FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0B1727" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#526274" />
    <SolidColorBrush x:Key="BorderBrush" Color="#84FFFFFF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0B82F6" />
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="#BDE8F3FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#087A52" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#BDECFDF5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#72FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />

    <!-- The artwork itself is blurred; translucent UI surfaces then read as frosted glass. -->
    <effects:BlurEffect x:Key="BackgroundBlurEffect" Radius="12" />
</ResourceDictionary>
